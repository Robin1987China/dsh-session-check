{
  "name": "dsh-session-check",
  "version": "0.1.2",
  "description": "Read-only diagnosis of stored DeepSeek Harness sessions (which a format migration will refuse, and which gate), offline maintenance for the projection cache, and a read-only cache-footprint diagnostic plugin.",
  "type": "module",
  "main": "src/scan.mjs",
  "exports": {
    ".": "./src/scan.mjs",
    "./gates": "./src/gates.mjs",
    "./projcache": "./src/projcache.mjs",
    "./diag": "./src/diag.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-session-check": "./bin/dsh-session-check.mjs",
    "dsh-projcache": "./bin/dsh-projcache.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "test/",
    "docs/",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session",
    "diagnostics",
    "migration",
    "projection-cache",
    "storage",
    "maintenance"
  ],
  "license": "MIT",
  "author": "Robin1987China",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Robin1987China/dsh-session-check.git"
  },
  "scripts": {
    "test": "node --test"
  }
}
